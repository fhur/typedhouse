---
/** A dark, editor-style window frame. Content uses the night syntax palette in every color mode. */
interface Props { title: string }
const { title } = Astro.props;
---
<figure class="code-window on-night">
  <figcaption class="titlebar">
    <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="title">{title}</span>
  </figcaption>
  <slot />
</figure>

<style>
  .code-window {
    margin: 0; min-width: 0; border-radius: 10px; overflow: hidden; background: var(--typedhouse-night-alt);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / .6); outline: 1px solid var(--typedhouse-night-border);
  }
  .titlebar { position: relative; display: flex; align-items: center; height: 40px; padding: 0 1rem; border-bottom: 1px solid rgb(255 255 255 / .07); }
  .dots { display: flex; gap: 8px; }
  .dots span { width: 12px; height: 12px; border-radius: 50%; background: #f74c4a; }
  .dots span:nth-child(2) { background: #f4c025; }
  .dots span:nth-child(3) { background: #4fd364; }
  .title { position: absolute; inset-inline: 4.5rem; text-align: center; font-size: .8125rem; font-weight: 600; color: #b5b9d8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
