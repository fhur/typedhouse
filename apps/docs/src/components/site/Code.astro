---
/** A highlighted, horizontally scrollable code block. Colors follow the surrounding `--tk-*` tokens. */
import { highlightToHtml, type Lang } from '../../lib/highlight';
interface Props { code: string; lang: Lang; label: string; class?: string }
const { code, lang, label, class: className } = Astro.props;
---
<pre class:list={['code', className]} tabindex="0" aria-label={label} data-lang={lang}><code set:html={highlightToHtml(code, lang)} /></pre>

<style>
  .code {
    margin: 0; padding: 1.25rem 1.375rem; overflow-x: auto; background: transparent; border: 0; border-radius: 0;
    font-family: var(--typedhouse-font-mono); font-size: .84rem; line-height: 1.75; color: var(--tk-plain);
    tab-size: 2;
  }
  .code:focus-visible { outline: 2px solid var(--typedhouse-accent); outline-offset: -2px; }
  .code :global(.tk-kw) { color: var(--tk-kw); }
  .code :global(.tk-fn) { color: var(--tk-fn); }
  .code :global(.tk-val) { color: var(--tk-val); }
  .code :global(.tk-num) { color: var(--tk-num); }
  .code :global(.tk-punct) { color: var(--tk-punct); }
  .code :global(.tk-comment) { color: var(--tk-comment); font-style: italic; }
</style>
