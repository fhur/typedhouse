---
import '../styles/site.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Fonts from '../components/site/Fonts.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { withBase } from '../lib/urls';
interface Props {
  title: string;
  description: string;
  /** Viewport-filling workbench (playground): compact header, no footer. */
  fullPage?: boolean;
  /** Full-bleed pages build their own bands with <Section>; others get a centered content column. */
  bleed?: boolean;
}
const { title, description, fullPage = false, bleed = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · TypedHouse`} />
    <meta property="og:site_name" content="TypedHouse" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="TypedHouse blog" href={withBase('/blog/rss.xml')} />
    <Fonts />
    <title>{title} · TypedHouse</title>
    <script is:inline>
      // Match Starlight's preference key and empty-string System convention.
      try {
        const theme = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
          ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>
  <body class:list={{ 'workbench-page': fullPage }}>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="before-header" />
    <SiteHeader compact={fullPage} />
    <main id="main" class:list={{ contained: !bleed && !fullPage }}><slot /></main>
    {!fullPage && <SiteFooter />}
  </body>
</html>
