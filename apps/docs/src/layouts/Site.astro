---
import '../styles/site.css';
import { withBase, withoutBase } from '../lib/urls';
interface Props { title: string; description: string; fullPage?: boolean }
const { title, description, fullPage = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = withoutBase(Astro.url.pathname);
const links = [
  { href: '/docs/getting-started/', label: 'Docs', prefix: '/docs/' },
  { href: '/playground/', label: 'Playground', prefix: '/playground/' },
  { href: '/blog/', label: 'Blog', prefix: '/blog/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="chql blog" href={withBase('/blog/rss.xml')} />
    <title>{title} · chql</title>
    <script is:inline>
      // Match Starlight's preference key and empty-string System convention.
      try {
        const theme = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
          ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>
  <body class:list={{ 'workbench-page': fullPage }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={withBase('/')} aria-current={pathname === '/' ? 'page' : undefined}>chql<span> / ClickHouse, composed.</span></a>
      <div class="header-tools">
        <nav aria-label="Main">
          {links.map(({ href, label, prefix }) => <a href={withBase(href)} aria-current={pathname.startsWith(prefix) ? 'page' : undefined}>{label}</a>)}
          <a class="agent-link" href={withBase('/llms.txt')} aria-label="For agents: Markdown documentation index">For agents ↗</a>
        </nav>
        <label class="theme-picker">Theme
          <select id="site-theme" aria-label="Color theme">
            <option value="auto">System</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </div>
    </header>
    <main id="main"><slot /></main>
    {!fullPage && <footer><strong>chql</strong><span>Explicit APIs. Typed constraints. Inspectable SQL.</span><a href={withBase('/llms.txt')}>Markdown index for agents</a></footer>}
    <script>
      const picker = document.querySelector<HTMLSelectElement>('#site-theme');
      const systemTheme = matchMedia('(prefers-color-scheme: dark)');
      let preference = 'auto';
      const applyTheme = (value: string | null) => {
        preference = value === 'light' || value === 'dark' ? value : 'auto';
        document.documentElement.dataset.theme = preference === 'auto'
          ? (systemTheme.matches ? 'dark' : 'light') : preference;
        if (picker) picker.value = preference;
      };
      systemTheme.addEventListener('change', () => {
        if (preference === 'auto') applyTheme('auto');
      });
      try { applyTheme(localStorage.getItem('starlight-theme')); } catch { applyTheme(null); }
      picker?.addEventListener('change', () => {
        applyTheme(picker.value);
        try { localStorage.setItem('starlight-theme', picker.value === 'auto' ? '' : picker.value); } catch { /* In-memory selection still works. */ }
      });
      window.addEventListener('storage', (event) => {
        if (event.key === 'starlight-theme' || event.key === null) applyTheme(event.newValue);
      });
    </script>
  </body>
</html>
