---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { withBase } from '../../lib/urls';
import MarkdownActions from '../../components/MarkdownActions.astro';
export async function getStaticPaths() {
  return (await getCollection('blog', ({ data }) => !data.draft)).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Site title={post.data.title} description={post.data.description}>
  <article class="prose" data-pagefind-body>
    <a href={withBase('/blog/')} data-pagefind-ignore>← All articles</a>
    <h1 data-pagefind-meta="title">{post.data.title}</h1>
    <p class="meta">{post.data.date.toISOString().slice(0,10)} · {post.data.author}{post.data.updated && ` · Updated ${post.data.updated.toISOString().slice(0,10)}`}</p>
    <MarkdownActions href={withBase(`/blog/${post.id}.md`)} />
    <Content />
  </article>
</Site>
