---
import { compile } from '@chql/compiler';
import { format } from 'sql-formatter';
import Site from '../layouts/Site.astro';
import { withBase } from '../lib/urls';
import query from '../examples/homepage';
import source from '../examples/homepage.ts?raw';
import { encodeShare } from '../playground/sharing';

const example = source.slice(source.indexOf('const base'));
const compiled = compile(query.ir);
const sql = format(compiled.sql, { language: 'clickhouse' });
const playground = `${withBase('/playground/')}#${await encodeShare(source)}`;
const guides = [
  { title: 'Getting started', description: 'Build and inspect your first query.', path: '/docs/getting-started/' },
  { title: 'Simple example', description: 'Reuse queries for reports and dashboards.', path: '/docs/tutorials/composition/' },
  { title: 'Advanced example', description: 'Combine tables without losing track of what you count.', path: '/docs/tutorials/advanced-example/' },
];
---
<Site title="Type-safe ClickHouse query builder for TypeScript" description="TypedHouse is a type-safe ClickHouse query builder for TypeScript. Compose reusable queries, keep values parameterized, and inspect the SQL you run.">
  <section class="home-hero" aria-labelledby="home-title">
    <h1 id="home-title">TypedHouse</h1>
    <p class="home-tagline">Type-safe ClickHouse query builder for TypeScript.</p>
    <div class="actions">
      <a class="button primary" href={withBase('/docs/getting-started/')}>Learn TypedHouse</a>
      <a class="button" href={withBase('/playground/')}>Try the playground</a>
    </div>
    <p class="meta">Preview</p>
  </section>

  <section class="home-example" aria-labelledby="example-title">
    <div class="section-intro">
      <h2 id="example-title">Build queries from reusable pieces.</h2>
      <p>Start with a shared query. Extend it without changing the original.</p>
    </div>
    <div class="code-pair">
      <figure>
        <figcaption>TypeScript</figcaption>
        <pre tabindex="0" aria-label="TypeScript example"><code>{example.trim()}</code></pre>
      </figure>
      <figure>
        <figcaption>Generated SQL</figcaption>
        <pre tabindex="0" aria-label="Generated SQL"><code>{sql}</code></pre>
        <p class="parameters">Parameters: <code>{JSON.stringify(compiled.params)}</code></p>
      </figure>
    </div>
    <p class="example-context">Uses the <a href={withBase('/docs/getting-started/#define-and-compile')}>events table from Getting started</a>. Values stay separate from SQL.</p>
    <a class="example-link" href={playground}>Edit in the playground →</a>
  </section>

  <section class="home-guides" aria-labelledby="guides-title">
    <h2 id="guides-title">Learn TypedHouse in three small steps.</h2>
    <ol>
      {guides.map(guide => (
        <li>
          <a href={withBase(guide.path)}>{guide.title} <span aria-hidden="true">→</span></a>
          <p>{guide.description}</p>
        </li>
      ))}
    </ol>
  </section>
</Site>

<style>
  .home-hero { padding: 6rem 0 5rem; text-align: center; }
  .home-hero h1 { margin: 0 auto 1.25rem; font-size: clamp(2.75rem, 8vw, 5rem); letter-spacing: -.05em; }
  .home-tagline { margin: 0 auto; max-width: 32ch; font-size: clamp(1.35rem, 3vw, 1.85rem); line-height: 1.5; color: var(--muted); text-wrap: balance; }
  .home-hero .actions { justify-content: center; margin: 1.75rem 0 1rem; }
  .home-hero .meta { margin: 0 auto; }
  .home-example { padding: 4rem 0; text-align: center; }
  .section-intro p { margin: 0 auto 2.25rem; color: var(--muted); }
  .code-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); text-align: left; border: 1px solid var(--border); border-radius: .75rem; overflow: hidden; }
  figure { margin: 0; min-width: 0; background: var(--panel); }
  figure + figure { border-left: 1px solid var(--border); }
  figcaption { padding: .75rem 1.25rem; font-size: .8rem; color: var(--muted); border-bottom: 1px solid var(--border); }
  .code-pair pre { margin: 0; border: 0; border-radius: 0; padding: 1.25rem; font-size: .8rem; background: transparent; }
  .code-pair pre:focus-visible { outline-offset: -3px; }
  .parameters { max-width: none; margin: 0; padding: 0 1.25rem 1.25rem; font-size: .75rem; color: var(--muted); }
  .example-context { margin: 1.25rem auto .5rem; font-size: .85rem; color: var(--muted); }
  .example-link { font-size: .9rem; }
  .home-guides { padding: 4rem 0; max-width: 42rem; margin: 0 auto; }
  .home-guides h2 { text-align: center; }
  .home-guides ol { margin: 2rem 0 0; padding-left: 1.75rem; }
  .home-guides li { padding: .75rem 0 .75rem .5rem; }
  .home-guides li::marker { color: var(--muted); }
  .home-guides a { font-weight: 600; text-decoration: none; }
  .home-guides a:hover { text-decoration: underline; }
  .home-guides li p { margin: .15rem 0 0; color: var(--muted); font-size: .95rem; }
  @media (max-width: 800px) {
    .home-hero { padding: 4rem 0; }
    .home-example, .home-guides { padding: 3rem 0; }
    .code-pair { grid-template-columns: 1fr; }
    figure + figure { border-left: 0; border-top: 1px solid var(--border); }
  }
</style>
