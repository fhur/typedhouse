{
  "description": "20 domain input shapes x 10 nonliteral relational compositions; bounded supported corpus, not all spec examples",
  "roots": [
    {
      "name": "componentPayload",
      "expression": "components.where(forTenant('acme')).map(c => ({ entityId: c.entityId, category: c.category, parts: c.part_specifications, count: c.countOfParts }))"
    },
    {
      "name": "partPayload",
      "expression": "parts.where(forTenant('acme')).map(p => ({ entityId: p.entityId, category: p.partCategoryId, path: p.partCategoryPath, years: p.lifecycleYteol }))"
    },
    {
      "name": "tupleExtraction",
      "expression": "components.map(c => ({ entityId: c.entityId, mpns: c.part_specifications.element('mpn'), first: c.part_specifications.arrayElement(1).element('description') }))"
    },
    {
      "name": "matchedParts",
      "expression": "components.arrayJoin(c => c.matched_part_ids, 'partId').map(c => ({ entityId: c.entityId, partId: c.partId }))"
    },
    {
      "name": "leftMatchedParts",
      "expression": "components.leftArrayJoin(c => c.matched_part_ids, 'partId').map(c => ({ entityId: c.entityId, partId: c.partId, count: c.countOfParts }))"
    },
    {
      "name": "componentPartJoin",
      "expression": "join({ c: components.arrayJoin(c => c.matched_part_ids, 'partId'), p: parts }).on(r => [r.c.tenantId.eq(r.p.tenantId), r.c.partId.eq(r.p.entityId)]).map(r => ({ entityId: r.c.entityId, mpn: r.p.mpn, lifecycle: r.p.lifecycleStatus }))"
    },
    {
      "name": "priceJoin",
      "expression": "join({ c: components.arrayJoin(c => c.matched_part_ids, 'partId'), p: parts, m: latest(prices.final()) }).on(r => [r.c.tenantId.eq(r.p.tenantId), r.c.partId.eq(r.p.entityId), r.p.tenantId.eq(r.m.tenantId), r.p.entityId.eq(r.m.entityId)]).map(r => ({ entityId: r.c.entityId, price: r.m.market_unit_price_1k_p50 }))"
    },
    {
      "name": "history",
      "expression": "join({ c: components, a: availability.final().where(a => a.effectiveAt.between(new Date('2026-01-01'), new Date('2026-10-27'))) }).on(r => [r.c.tenantId.eq(r.a.tenantId), r.c.entityId.eq(r.a.entityId)]).map(r => ({ entityId: r.c.entityId, at: r.a.effectiveAt, stock: r.a.market_stock_total }))"
    },
    {
      "name": "availabilityLatest",
      "expression": "latest(availability.final()).map(r => ({ entityId: r.entityId, stock: r.market_stock_total, warnings: r.market_stock_total_warnings }))"
    },
    {
      "name": "componentLatest",
      "expression": "latest(cIndices.final()).map(r => ({ entityId: r.entityId, stock: r.stock_index, lead: r.lead_time_max_days }))"
    },
    {
      "name": "partLatest",
      "expression": "latest(pIndices.final()).map(r => ({ entityId: r.entityId, stock: r.stock_index, lead: r.lead_time_index_days.divide(r.lead_time_index_count) }))"
    },
    {
      "name": "priceLatest",
      "expression": "latest(prices.final()).map(r => ({ entityId: r.entityId, price: r.market_unit_price_1k_p50, warnings: r.market_unit_price_1k_p50_warnings }))"
    },
    {
      "name": "argMaxLatest",
      "expression": "cIndices.final().groupBy(r => ({ entityId: r.entityId })).aggregate(g => ({ stock: argMax(g.stock_index, g.version), lead: argMax(g.lead_time_max_days, g.version) }))"
    },
    {
      "name": "weekly",
      "expression": "availability.final().groupBy(r => ({ entityId: r.entityId, week: r.effectiveAt.toStartOfWeek() })).aggregate(g => ({ mean: avg(g.market_stock_total), median: quantile(0.5)(g.market_lead_time_p50_days) }))"
    },
    {
      "name": "versionTotals",
      "expression": "cIndices.final().groupBy(r => ({ entityId: r.entityId })).aggregate(g => ({ versions: sum(g.version), stock: sum(g.stock_index), warned: countIf(g.stock_index_warnings.notEmpty()) }))"
    },
    {
      "name": "scalarShare",
      "expression": "availability.map(r => ({ entityId: r.entityId, share: r.market_stock_total.divide(scalar(availability.aggregate(g => sum(g.market_stock_total)))) }))"
    },
    {
      "name": "membership",
      "expression": "components.where(c => c.entityId.in(cIndices.where(i => i.stock_index.lt(0.5)).map(i => i.entityId))).map(c => ({ entityId: c.entityId, count: c.countOfParts }))"
    },
    {
      "name": "entityUnion",
      "expression": "unionAll(components.map(c => ({ entityId: c.entityId, category: c.category })), parts.map(p => ({ entityId: p.entityId, category: p.partCategoryName })))"
    },
    {
      "name": "manufacturerStock",
      "expression": "join({ p: parts, i: latest(pIndices.final()) }).on(r => [r.p.tenantId.eq(r.i.tenantId), r.p.entityId.eq(r.i.entityId)]).groupBy(r => ({ entityId: r.p.manufacturerId })).aggregate(g => ({ stock: sum(g.i.stock_index), parts: count(), eol: countIf(g.p.lifecycleStatus.in(['EOL', 'Obsolete'])) }))"
    },
    {
      "name": "categoryStock",
      "expression": "join({ c: components, i: latest(cIndices.final()) }).on(r => [r.c.tenantId.eq(r.i.tenantId), r.c.entityId.eq(r.i.entityId)]).groupBy(r => ({ entityId: r.c.category.ifNull('uncategorised') })).aggregate(g => ({ stock: sum(g.i.stock_index), entities: uniq(g.c.entityId), price: exp(sum(g.i.price_change_log_sum).divide(sum(g.i.price_change_count))) }))"
    }
  ],
  "topologies": [
    "project",
    "distinctFilter",
    "orderedPage",
    "groupCount",
    "semiJoin",
    "repeatedUnion",
    "sharedCte",
    "entityEnrichment",
    "arrayEnrichment",
    "rollupShare"
  ],
