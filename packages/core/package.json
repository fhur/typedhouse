    "sql-builder",
    "type-safe",
    "typesafe",
    "olap",
    "analytics",
    "typedhouse",
    "clickhouse-query-builder",
    "query",
    "joins",
    "aggregation",
    "inference"
  ],
  "homepage": "https://fhur.github.io/typedhouse/docs/query-builder/overview/",
  "bugs": {
    "url": "https://github.com/fhur/typedhouse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fhur/typedhouse.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Fernando Hurtado",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
