{
  "name": "@typedhouse/studio",
  "version": "0.0.0",
  "private": true,
  "description": "Local TypedHouse workspace: write a query, run it against ClickHouse, see rows and SQL.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "typedhouse-studio": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx server/main.ts --dev",
    "build": "vite build && tsup server/main.ts server/types-worker.ts --format esm --out-dir dist --no-splitting --clean=false",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/studio/",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.11.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@trpc/server": "^11.0.0",
    "@typedhouse/client": "workspace:*",
    "@typedhouse/codegen": "workspace:*",
    "@typedhouse/compiler": "workspace:*",
    "@typedhouse/core": "workspace:*",
    "proper-lockfile": "^4.1.2",
    "superjson": "^2.2.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.5",
    "@trpc/client": "^11.0.0",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "codemirror": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql-formatter": "^15.9.0",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "vitest": "^5.0.5"
  }
}
