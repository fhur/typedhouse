    "url": "https://github.com/fhur/typedhouse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fhur/typedhouse.git",
    "directory": "packages/devtools"
  },
  "license": "MIT",
  "author": "Fernando Hurtado",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
