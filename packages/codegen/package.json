{
  "name": "@chql/codegen",
  "version": "0.1.0",
  "type": "module",
  "bin": { "chql": "./dist/cli.js" },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@chql/core": "workspace:*",
    "@clickhouse/client": "^1.11.0"
  }
}
