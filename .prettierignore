# The one exclude list for `pnpm format`: Prettier reads this file, and eslint.config.mjs converts
# it to ESLint ignores. Write every pattern relative to the repository root, using `**/` for "at any
# depth" and a trailing `/` for a directory. Negation is not supported.

# Build output and local state. Prettier also reads .gitignore; ESLint does not.
**/node_modules/
**/dist/
**/coverage/
**/test-results/
**/playwright-report/
apps/docs/.astro/
apps/docs/public/sandbox/worker.js
apps/playground/
.worktrees/
# Temporary output of type-mapping.test.ts, which remains if the test run crashes.
test/types/.runtime-mapping-*

# Expected diagnostics are matched by exact line (check-type-diagnostics.mjs).
test/types/negative/

# Byte-compared with generator output, and hashed into budget.json `inputHash`.
test/types/bench/
scripts/generate-type-bench.mjs
scripts/generate-type-stress.mjs

