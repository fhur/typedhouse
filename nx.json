{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "cacheDirectory": ".nx/cache",
  "useInferencePlugins": false,
  "namedInputs": {
    "workspaceSources": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/**/node_modules/**/*",
      "!{workspaceRoot}/**/dist/**/*",
      "!{workspaceRoot}/**/.astro/**/*",
      "!{workspaceRoot}/apps/docs/public/sandbox/worker.js",
      "!{workspaceRoot}/**/coverage/**/*",
      "!{workspaceRoot}/**/*.tsbuildinfo",
      "!{workspaceRoot}/**/test-results/**/*",
      "!{workspaceRoot}/**/playwright-report/**/*",
      "!{workspaceRoot}/.nx/**/*",
      "!{workspaceRoot}/.worktrees/**/*"
    ],
    "checkInputs": [
      "workspaceSources",
      { "runtime": "node -p \"[process.version, process.platform, process.arch].join('/')\"" },
      { "runtime": "pnpm --version" }
    ]
  },
  "targetDefaults": {
    "nx:run-commands": {
      "cache": false,
      "inputs": ["checkInputs"],
      "outputs": []
    }
  }
}
