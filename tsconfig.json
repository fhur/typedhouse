{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@typedhouse/core": ["./packages/core/src/index.ts"],
      "@typedhouse/compiler": ["./packages/compiler/src/index.ts"],
      "@typedhouse/client": ["./packages/client/src/index.ts"],
      "@typedhouse/codegen": ["./packages/codegen/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/dist", "node_modules", "**/test/types/negative/**"]
}
